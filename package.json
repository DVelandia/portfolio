{
  "name": "portfolio-dvelandia",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "clean:dev-cache": "node scripts/clean-dev-cache.mjs",
    "dev:clean": "pnpm clean:dev-cache && astro dev",
    "start": "astro dev",
    "generate:blur": "node scripts/generate-blur-placeholders.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "csp:update": "node scripts/csp-hashes.mjs",
    "csp:check": "node scripts/csp-hashes.mjs --check",
    "test": "pnpm build && pnpm csp:check && pnpm test:smoke",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "test:smoke": "node --test tests/smoke/navigation.test.mjs",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/onest": "^5.2.11",
    "@vercel/analytics": "^2.0.1",
    "astro": "^6.3.5",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "8.2.0",
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "4.3.2",
    "@typescript-eslint/parser": "8.62.0",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "serve": "^14.2.6",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "volta": {
    "node": "22.15.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
