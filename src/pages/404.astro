---
import SectionContainer from "@/components/SectionContainer.astro"
import { publicProfile } from "@/data/publicProfile"
import { getI18N } from "@/i18n/"
import Layout from "@/layouts/Layout.astro"

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })

const {
	code,
	message,
	context,
	back,
	seo: { title, description },
} = i18n.error
const homeHref = currentLocale === "en" ? "/en/" : "/"
---

<Layout
	description={description}
	title={title}
	robots="noindex, nofollow"
	googlebot="noindex, nofollow"
	includeRichResults={false}
	showAlternateLinks={false}
>
	<main id="main-content" class="px-4">
		<SectionContainer id={i18n.error.id} class="mt-14 flex flex-col items-center gap-y-8">
			<div class="flex flex-col items-center justify-center md:flex-row">
				<a href={homeHref} class="mb-8 md:mr-12 md:mb-0">
					<img
						src="/logo.webp"
						alt={`${publicProfile.fullName} logo`}
						title={`${publicProfile.fullName} logo`}
						width={495}
						height={339}
						class="h-auto w-[200px] md:w-[300px]"
						loading="eager"
						decoding="async"
					/>
				</a>
				<div class="text-center md:text-left">
					<h1 class="mb-6 text-4xl font-bold uppercase md:text-5xl">
						{code}
					</h1>
					<h2 class="text-primary-400 mb-4 text-lg font-medium uppercase md:text-2xl">
						{message}
					</h2>
					<p class="mb-6 max-w-md text-lg text-gray-600 dark:text-gray-300">{context}</p>
				</div>
			</div>
			<a
				href={homeHref}
				class="h-9 px-4 py-2 text-lg font-medium underline-offset-4 hover:underline"
				aria-label={back}
			>
				{back}
			</a>
		</SectionContainer>
	</main>
</Layout>
