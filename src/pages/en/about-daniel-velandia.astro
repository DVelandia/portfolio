---
import Layout from "@/layouts/Layout.astro"
import { publicProfile } from "@/data/publicProfile"

const title = "About Daniel Velandia | Full-Stack Software Engineer in Colombia"
const description =
	"Learn about Daniel Velandia, a Full-Stack Software Engineer in Colombia focused on Angular, Node.js, GCP, enterprise integrations, and applied AI."
const alternateLinks = [
	{ href: "/sobre-daniel-velandia/", hreflang: "es" },
	{ href: "/en/about-daniel-velandia/", hreflang: "en" },
	{ href: "/sobre-daniel-velandia/", hreflang: "x-default" },
]
const focusAreas = [
	"Frontend development with Angular, TypeScript, and scalable architectures.",
	"Backend services with Node.js, Express, and NestJS for APIs and integrations.",
	"Enterprise web platforms on Google Cloud Platform, Docker, and CI/CD.",
	"Automation and applied AI for real production workflows.",
]
const links = [
	{ href: "/en/", label: "Back to portfolio" },
	{ href: "/en/#projects", label: "View featured projects" },
	{ href: publicProfile.social.linkedin, label: "LinkedIn", external: true },
	{ href: publicProfile.social.github, label: "GitHub", external: true },
]
---

<Layout title={title} description={description} alternateLinks={alternateLinks}>
	<main id="main-content" class="px-4">
		<article class="mx-auto w-full pt-28 sm:w-[600px] lg:w-[740px]">
			<header class="mb-10">
				<p class="text-primary-700 dark:text-primary-300 mb-3 text-sm font-semibold uppercase">
					Professional profile
				</p>
				<h1 class="text-dark-950 dark:text-primary-50 text-4xl font-bold text-balance sm:text-5xl">
					About Daniel Velandia
				</h1>
				<p class="text-dark-700 dark:text-dark-200 mt-5 text-lg leading-8">
					I am Daniel Velandia, a Full-Stack Software Engineer in Colombia. I build enterprise web
					platforms with a focus on Angular, Node.js, GCP, integrations, and applied AI.
				</p>
			</header>

			<section class="border-dark-200 dark:border-dark-800 border-t py-8">
				<h2 class="text-dark-900 dark:text-primary-50 mb-4 text-2xl font-bold">What I do</h2>
				<p class="text-dark-700 dark:text-dark-200 leading-8">
					My work combines frontend, backend, cloud, and automation. I focus on maintainable,
					secure, useful systems for teams operating real web products, not isolated interfaces.
				</p>
			</section>

			<section class="border-dark-200 dark:border-dark-800 border-t py-8">
				<h2 class="text-dark-900 dark:text-primary-50 mb-4 text-2xl font-bold">Specialties</h2>
				<ul class="text-dark-700 dark:text-dark-200 grid gap-3 leading-7">
					{
						focusAreas.map((item) => (
							<li class="border-dark-200 dark:border-dark-800 border-l-2 pl-4">{item}</li>
						))
					}
				</ul>
			</section>

			<section class="border-dark-200 dark:border-dark-800 border-t py-8">
				<h2 class="text-dark-900 dark:text-primary-50 mb-4 text-2xl font-bold">
					Professional identity
				</h2>
				<p class="text-dark-700 dark:text-dark-200 leading-8">
					This site is Daniel Velandia's official portfolio as a software professional. It brings
					together my experience, projects, technical stack, resume, and public profiles so Google,
					recruiters, and technical teams can clearly associate my name with full-stack development,
					cloud platforms, and web engineering.
				</p>
			</section>

			<nav class="border-dark-200 dark:border-dark-800 flex flex-wrap gap-3 border-t py-8">
				{
					links.map(({ href, label, external }) => (
						<a
							class="border-dark-300 dark:border-dark-700 text-dark-800 dark:text-dark-100 hover:border-primary-500 dark:hover:border-primary-400 rounded-full border px-4 py-2 text-sm font-semibold transition-colors"
							href={href}
							target={external ? "_blank" : undefined}
							rel={external ? "noopener noreferrer" : undefined}
						>
							{label}
						</a>
					))
				}
			</nav>
		</article>
	</main>
</Layout>
