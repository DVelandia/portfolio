---
import { getI18N } from "@/i18n"

const { currentLocale } = Astro
const t = getI18N({ currentLocale })

const { personSchema: tPersonSchema } = t.richResults

/** https://developers.google.com/search/docs/appearance/structured-data/person */
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Daniel Velandia",
	"givenName": "Daniel",
	"familyName": "Velandia",
	"additionalName": "DVelandia",
	"url": "https://daniel.velandia.dev/",
	"image": "https://daniel.velandia.dev/og.png",
	"sameAs": ["https://www.linkedin.com/in/dvelandia", "https://github.com/dvelandia"],
	"jobTitle": tPersonSchema.jobTitle,
	"description": tPersonSchema.description,
	"birthDate": "2005-01-03",
	"gender": tPersonSchema.gender,
	"nationality": tPersonSchema.nationality,
	"address": {
		"@type": "PostalAddress",
		"addressLocality": "Chiquinquirá",
		"addressRegion": "Boyacá",
		"addressCountry": "Colombia",
	},
	"email": "dfvf03@gmail.com",
	"telephone": "+57 3028325223",
	"alumniOf": tPersonSchema.alumniOf.map(({ description }, index) => ({
		"@type": "EducationalOrganization",
		"name":
			["UNISANGIL", "Platzi", "Escuela Normal Superior de Chiquinquirá"][index] ?? "UNISANGIL",
		description,
	})),
	"knowsLanguage": tPersonSchema.knowsLanguage,
	"worksFor": {
		"@type": "Organization",
		"name": "Davinci Technologies",
		"description": tPersonSchema.worksFor.description,
	},
	"memberOf": [
		{
			"@type": "Organization",
			"name": "Platzi",
		},
		{
			"@type": "Organization",
			"name": "UNISANGIL",
		},
		{
			"@type": "Organization",
			"name": "Davinci Technologies",
		},
	],
	"skills": [
		"Desarrollo Front-end",
		"CMS (Drupal, WordPress)",
		"HTML5",
		"CSS3",
		"SASS",
		"JavaScript (ES6+)",
		"JQuery",
		"TypeScript",
		"Angular",
		"Node.js",
		"PHP",
		"MySQL",
		"Docker",
		"Git",
		"CI/CD",
		"UI/UX Design",
		"Responsive Web Design",
	],
	"award": tPersonSchema.award.map(({ name, description }) => ({
		"@type": "Award",
		name,
		description,
	})),
	"potentialAction": tPersonSchema.potentialAction.map(({ name }, index) => ({
		"@type": index === 2 ? "DownloadAction" : index === 1 ? "ViewAction" : "ContactAction",
		name,
		"target":
			index === 2
				? "https://daniel.velandia.dev/CVelandia.pdf"
				: index === 1
					? "https://daniel.velandia.dev/#projects"
					: "https://www.linkedin.com/in/dvelandia",
	})),
}
---

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
