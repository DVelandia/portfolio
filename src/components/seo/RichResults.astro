---
import { getResumePath, publicProfile, toPublicUrl } from "@/data/publicProfile"
import { getI18N } from "@/i18n"

const { currentLocale } = Astro
const t = getI18N({ currentLocale })
const resumePath = getResumePath(currentLocale)
const currentPageUrl = toPublicUrl(Astro.url.pathname)

const { personSchema: tPersonSchema } = t.richResults

/** https://schema.org/Person – validated against https://schema.org/Person spec */
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"@id": `${publicProfile.siteUrl}#person`,
	"name": publicProfile.fullName,
	"givenName": publicProfile.givenName,
	"familyName": publicProfile.familyName,
	"additionalName": publicProfile.additionalName,
	"url": publicProfile.siteUrl,
	"image": publicProfile.defaultImageUrl,
	"email": publicProfile.contact.email,
	"sameAs": Object.values(publicProfile.social),
	"jobTitle": tPersonSchema.jobTitle,
	"description": tPersonSchema.description,
	"gender": "https://schema.org/Male",
	"nationality": { "@type": "Country", "name": "Colombia" },
	"address": {
		"@type": "PostalAddress",
		"addressLocality": publicProfile.location.locality,
		"addressRegion": publicProfile.location.region,
		"addressCountry": "CO",
	},
	"alumniOf": tPersonSchema.alumniOf.map(({ description }, index) => ({
		"@type": "EducationalOrganization",
		"name": publicProfile.organizations.alumniOf[index] ?? publicProfile.organizations.alumniOf[0],
		description,
	})),
	"knowsLanguage": [
		{ "@type": "Language", "name": "Spanish", "alternateName": "es" },
		{ "@type": "Language", "name": "English", "alternateName": "en" },
	],
	"worksFor": {
		"@type": "Organization",
		"name": publicProfile.organizations.worksFor,
		"description": tPersonSchema.worksFor.description,
	},
	"skills": publicProfile.skills,
	"award": tPersonSchema.award.map(({ name, description }) => `${name} — ${description}`),
	"potentialAction": [
		{
			"@type": "ViewAction",
			"name": tPersonSchema.potentialAction[0].name,
			"target": toPublicUrl("/#projects"),
		},
		{
			"@type": "DownloadAction",
			"name": tPersonSchema.potentialAction[1].name,
			"target": toPublicUrl(resumePath),
		},
	],
}

/** https://schema.org/WebSite */
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": `${publicProfile.siteUrl}#website`,
	"name": t.seo.og_site_name,
	"url": publicProfile.siteUrl,
	"inLanguage": ["es", "en"],
	"author": {
		"@type": "Person",
		"@id": `${publicProfile.siteUrl}#person`,
	},
}

/** https://schema.org/ProfilePage */
const profilePageSchema = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	"@id": `${currentPageUrl}#profile-page`,
	"url": currentPageUrl,
	"name": t.seo.og_site_name,
	"description": t.seo.description,
	"inLanguage": currentLocale === "en" ? "en" : "es",
	"mainEntity": {
		"@type": "Person",
		"@id": `${publicProfile.siteUrl}#person`,
	},
}
---

<script type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
