---
import { getResumePath, publicProfile, toPublicUrl } from "@/data/publicProfile"
import { getI18N } from "@/i18n"

const { currentLocale } = Astro
const t = getI18N({ currentLocale })
const resumePath = getResumePath(currentLocale)

const { personSchema: tPersonSchema } = t.richResults

/** https://developers.google.com/search/docs/appearance/structured-data/person */
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": publicProfile.fullName,
	"givenName": publicProfile.givenName,
	"familyName": publicProfile.familyName,
	"additionalName": publicProfile.additionalName,
	"url": publicProfile.siteUrl,
	"image": publicProfile.defaultImageUrl,
	"sameAs": Object.values(publicProfile.social),
	"jobTitle": tPersonSchema.jobTitle,
	"description": tPersonSchema.description,
	"gender": tPersonSchema.gender,
	"nationality": tPersonSchema.nationality,
	"address": {
		"@type": "PostalAddress",
		"addressLocality": publicProfile.location.locality,
		"addressRegion": publicProfile.location.region,
		"addressCountry": publicProfile.location.country,
	},
	"alumniOf": tPersonSchema.alumniOf.map(({ description }, index) => ({
		"@type": "EducationalOrganization",
		"name": publicProfile.organizations.alumniOf[index] ?? publicProfile.organizations.alumniOf[0],
		description,
	})),
	"knowsLanguage": tPersonSchema.knowsLanguage,
	"worksFor": {
		"@type": "Organization",
		"name": publicProfile.organizations.worksFor,
		"description": tPersonSchema.worksFor.description,
	},
	"memberOf": publicProfile.organizations.memberOf.map((name) => ({
		"@type": "Organization",
		name,
	})),
	"skills": publicProfile.skills,
	"award": tPersonSchema.award.map(({ name, description }) => ({
		"@type": "Award",
		name,
		description,
	})),
	"potentialAction": tPersonSchema.potentialAction.map(({ name }, index) => ({
		"@type": index === 2 ? "DownloadAction" : index === 1 ? "ViewAction" : "ContactAction",
		name,
		"target":
			index === 2
				? toPublicUrl(resumePath)
				: index === 1
					? toPublicUrl("/#projects")
					: publicProfile.social.linkedin,
	})),
}
---

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
