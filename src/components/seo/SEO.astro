---
import { getI18N } from "@/i18n"
import RichResults from "@/components/seo/RichResults.astro"
import type { Preload } from "@/types/Preload"

interface Props {
	title: string
	description: string
	preload?: Array<Preload>
	canonical?: string
	image?: string
	robots?: string
	googlebot?: string
	includeRichResults?: boolean
}

const {
	title,
	description,
	preload,
	canonical,
	image = "https://daniel.velandia.dev/og.png",
	robots = "index, follow",
	googlebot = robots,
	includeRichResults = true,
} = Astro.props as Props

const { currentLocale } = Astro
const t = getI18N({ currentLocale })

const siteURL = Astro.site ?? Astro.url
const canonicalURL = new URL(canonical ?? Astro.url.pathname, siteURL)
const imageURL = new URL(image, siteURL)
---

<title>{title}</title>

<meta charset="UTF-8" />
<meta name="description" content={description} />

{
	preload?.map(({ href, as, type, rel = "preload", crossorigin }) => (
		<link {rel} {href} {as} {type} {crossorigin} />
	))
}

<link rel="canonical" href={canonicalURL} />
<link rel="manifest" href="/img/icons/manifest.json" />
<meta name="generator" content={Astro.generator} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#2CC9FF" />

<meta name="keywords" content={t.seo.keywords} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@dvelandia" />
<meta name="twitter:creator" content="@dvelandia" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<meta property="og:image" content={imageURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={t.seo.og_site_name} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={t.seo.og_locale} />

<meta name="robots" content={robots} />
<meta name="googlebot" content={googlebot} />

<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/img/icons/apple-touch-icon.png" />
<meta name="msapplication-config" content="/browserconfig.xml" />

{includeRichResults && <RichResults />}
