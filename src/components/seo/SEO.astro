---
import { publicProfile } from "@/data/publicProfile"
import { getI18N } from "@/i18n"
import RichResults from "@/components/seo/RichResults.astro"
import type { Preload } from "@/types/Preload"

interface Props {
	title: string
	description: string
	preload?: Array<Preload>
	canonical?: string
	image?: string
	robots?: string
	googlebot?: string
	includeRichResults?: boolean
}

const {
	title,
	description,
	preload,
	canonical,
	image = publicProfile.defaultImageUrl,
	robots = "index, follow",
	googlebot = robots,
	includeRichResults = true,
} = Astro.props as Props

const currentLocale = Astro.currentLocale === "en" ? "en" : "es"
const t = getI18N({ currentLocale })
const alternateOgLocales = {
	en: "es_CO",
	es: "en_US",
} as const

const siteURL = Astro.site ?? Astro.url
const canonicalURL = new URL(canonical ?? Astro.url.pathname, siteURL)
const imageURL = new URL(image, siteURL)
---

<title>{title}</title>

<meta name="description" content={description} />
<meta name="author" content={publicProfile.fullName} />
<meta name="keywords" content={t.seo.keywords} />

{
	preload?.map(({ href, as, type, rel = "preload", crossorigin }) => (
		<link {rel} {href} {as} {type} {crossorigin} />
	))
}

<link rel="canonical" href={canonicalURL} />
<meta name="viewport" content="width=device-width, initial-scale=1" />

{/* theme-color: matches design tokens — light=#f8fafc (dark-50), dark=#020617 (dark-950) */}
<meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />

{/* Open Graph */}
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={t.seo.og_site_name} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={t.seo.og_locale} />
<meta property="og:locale:alternate" content={alternateOgLocales[currentLocale]} />

{/* Twitter / X Card */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={publicProfile.twitterHandle} />
<meta name="twitter:creator" content={publicProfile.twitterHandle} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={title} />

{/* Indexing directives */}
<meta name="robots" content={robots} />
<meta name="googlebot" content={googlebot} />

{/* Icons */}
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/img/icons/apple-touch-icon.png" />

{includeRichResults && <RichResults />}
