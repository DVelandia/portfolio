---
interface Props {
	class?: string
	id: string
	title?: string
}

const { class: className, id, title } = Astro.props
---

<section
	id={id}
	class:list={`mx-auto w-full pt-14 sm:w-[600px] sm:pt-20 lg:w-[740px] lg:pt-24 ${className}`}
>
	{
		title && (
			<h2 class="text-dark-900 dark:text-primary-50 mb-6 flex items-center gap-x-3 text-2xl font-bold sm:text-3xl">
				<slot name="icon" />
				{title}
			</h2>
		)
	}

	<slot />
</section>
