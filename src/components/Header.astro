---
import { publicProfile } from "@/data/publicProfile"
import LanguageSelector from "@/components/ui/LanguageSelector.astro"
import ThemeToggle from "@/components/ui/ThemeToggle.astro"
import { getI18N } from "@/i18n"
import HamburgerButton from "@/icons/HamburgerButton.astro"
import headerScriptUrl from "@/scripts/header.js?url"

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })

const spanMenu = i18n.spanMenu
const currentYear = new Date().getFullYear()

const pages = ["about", "experience", "projects", "technologies"].map((key) => ({
	id: (i18n[key as keyof typeof i18n] as { id: string }).id,
	label: i18n.menu[key as keyof typeof i18n.menu],
	url: `${currentLocale === "en" ? "/en/" : "/"}#${(i18n[key as keyof typeof i18n] as { id: string }).id}`,
}))
---

<header class="fixed inset-x-0 z-20 px-4 py-4 backdrop-blur-md lg:p-0">
	<div
		class="mx-auto flex items-center justify-end gap-x-2 sm:w-[600px] lg:w-[740px] lg:justify-between"
	>
		<nav
			id="mobile-menu"
			class="fixed inset-0 z-10 hidden h-dvh w-full flex-col items-center gap-2 bg-gray-200 text-center text-2xl transition-transform dark:bg-gray-900"
			aria-label="Mobile Navigation"
			aria-hidden="true"
			tabindex="-1"
		>
			<div class="flex min-h-16 w-full items-center justify-between px-6 pt-4">
				<a href={currentLocale === "en" ? "/en/" : "/"} class="inline-flex items-center">
					<img
						src="/logo.webp"
						title={`${publicProfile.fullName} logo`}
						alt={`${publicProfile.fullName} logo`}
						class="accent-drop-shadow max-w-24 drop-shadow-lg"
						width={495}
						height={339}
						loading="eager"
						decoding="async"
					/>
				</a>
				<span
					id="mobile-menu-title"
					class="text-primary-600 dark:text-primary-400 text-xl font-semibold uppercase"
				>
					{spanMenu}
				</span>
			</div>
			<hr class="h-[2px] w-full border-t-0" />
			<div
				class="content-mobile fixed inset-0 z-20 flex h-dvh w-full flex-col items-center justify-center gap-6 px-6 pt-16 text-center text-2xl"
			>
				<ul class="flex w-full max-w-xs flex-col items-center gap-3">
					{
						pages.map((link) => (
							<li class="w-full">
								<a
									href={link.url}
									class="menu-item text-dark-800 dark:text-dark-100 hover:text-primary-600 hover:dark:text-primary-400 block rounded px-3 py-2 text-xl transition"
									data-nav-target={link.id}
								>
									{link.label}
								</a>
								<hr class="mt-3 h-[2px] w-full border-t-0" />
							</li>
						))
					}
				</ul>
				<span class="text-dark-900 dark:text-dark-200 text-center text-xl">
					©️ {currentYear}
					{publicProfile.fullName}. {i18n.rightsReserved}
				</span>
			</div>
		</nav>
		<nav
			class="hidden w-full items-center justify-between py-4 pr-4 sm:flex"
			aria-label="Desktop Navigation"
		>
			<ul class="flex w-full items-center justify-between gap-4">
				{
					pages.map((link) => (
						<li>
							<a
								class="nav-link text-dark-800 dark:text-dark-200 hover:text-primary-700 dark:hover:text-primary-400 relative z-10 overflow-hidden p-2 transition-all duration-300"
								href={link.url}
								data-nav-target={link.id}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<LanguageSelector />
		<ThemeToggle />
		<HamburgerButton />
	</div>

	<style>
		.nav-link::before {
			content: "";
			position: absolute;
			bottom: 0;
			left: 0;
			height: 2px;
			width: 0;
			background-color: #4299e1;
			backdrop-filter: blur(8px);
			border-radius: 0.5rem;
			z-index: -10;
			transition: all 0.5s;
		}

		.nav-link:hover::before {
			width: 100%;
		}

		@keyframes fadeIn {
			from {
				opacity: 0;
			}

			to {
				opacity: 1;
			}
		}

		@keyframes fadeOut {
			from {
				opacity: 1;
			}

			to {
				opacity: 0;
			}
		}

		@keyframes growIn {
			from {
				transform: scale(0.96);
				opacity: 0;
			}

			to {
				transform: scale(1);
				opacity: 1;
			}
		}

		.menu-open {
			animation: fadeIn 0.2s ease forwards;
		}

		.menu-close {
			animation: fadeOut 0.2s ease forwards;
			opacity: 0;
		}

		.content-mobile {
			animation: growIn 0.25s ease forwards;
			opacity: 0;
		}

		html.dark hr {
			background: linear-gradient(to right, transparent 0%, white 50%, transparent 100%);
		}

		hr {
			background: linear-gradient(to right, transparent 0%, black 50%, transparent 100%);
		}
	</style>

	<script is:inline src={headerScriptUrl}></script>
</header>
