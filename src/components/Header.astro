---
import { publicProfile } from "@/data/publicProfile"
import LanguageSelector from "@/components/ui/LanguageSelector.astro"
import ThemeToggle from "@/components/ui/ThemeToggle.astro"
import { getI18N } from "@/i18n"
import HamburgerButton from "@/icons/HamburgerButton.astro"
import logoImage from "@/assets/logo.webp"
import { Image } from "astro:assets"

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })

const spanMenu = i18n.spanMenu
const navLabels = i18n.nav
const currentYear = new Date().getFullYear()

const pages = ["about", "experience", "projects", "technologies"].map((key) => ({
	id: (i18n[key as keyof typeof i18n] as { id: string }).id,
	label: i18n.menu[key as keyof typeof i18n.menu],
	url: `${currentLocale === "en" ? "/en/" : "/"}#${(i18n[key as keyof typeof i18n] as { id: string }).id}`,
}))
---

<header class="fixed inset-x-0 z-20 px-4 py-4 backdrop-blur-md lg:p-0">
	<div
		class="mx-auto flex items-center justify-end gap-x-2 sm:w-[600px] lg:w-[740px] lg:justify-between"
	>
		<nav
			id="mobile-menu"
			class="fixed inset-0 z-10 flex hidden h-dvh w-full flex-col bg-white dark:bg-gray-900"
			aria-label={navLabels.mobileLabel}
			aria-hidden="true"
			tabindex="-1"
		>
			{/* ── Top bar ─────────────────────────────── */}
			<div class="flex min-h-[72px] shrink-0 items-center justify-between px-6">
				<span
					id="mobile-menu-title"
					class="text-xl font-bold tracking-widest text-gray-900 uppercase dark:text-gray-100"
				>
					{spanMenu}
				</span>
				{/* Spacer for the X button (z-50, rendered outside this nav) */}
				<div class="h-10 w-10" aria-hidden="true"></div>
			</div>
			<hr class="h-[2px] shrink-0 border-t-0" />

			{/* ── Logo — fixed size, centered ─────────── */}
			<div class="flex shrink-0 justify-center px-8 py-6">
				<a href={currentLocale === "en" ? "/en/" : "/"} class="inline-flex items-center">
					<Image
						src={logoImage}
						title={`${publicProfile.fullName} logo`}
						alt={`${publicProfile.fullName} logo`}
						class="accent-drop-shadow w-48 max-w-full drop-shadow-xl"
						widths={[192, 256, 384, 672]}
						sizes="192px"
						width={672}
						height={490}
						quality={80}
						loading="eager"
						decoding="async"
					/>
				</a>
			</div>
			<hr class="h-[2px] shrink-0 border-t-0" />

			{/* ── Nav links + footer — centered in remaining space ── */}
			<div
				class="content-mobile flex flex-1 flex-col items-center justify-center gap-5 px-6 pt-4 pb-6 text-center"
			>
				<ul class="flex w-full max-w-xs flex-col items-center gap-1">
					{
						pages.map((link) => (
							<li class="w-full">
								<a
									href={link.url}
									class="menu-item text-dark-800 dark:text-dark-100 hover:text-primary-600 hover:dark:text-primary-400 focus-visible:text-primary-600 dark:focus-visible:text-primary-400 block rounded px-3 py-2 text-xl transition focus:outline-none"
									data-nav-target={link.id}
								>
									{link.label}
								</a>
								<hr class="mt-1 h-[2px] w-full border-t-0" />
							</li>
						))
					}
				</ul>
				<span class="text-dark-900 dark:text-dark-200 text-center text-xs opacity-70">
					©️ {currentYear}
					{publicProfile.fullName}
				</span>
			</div>
		</nav>
		<nav
			class="hidden w-full items-center justify-between py-4 pr-4 sm:flex"
			aria-label={navLabels.desktopLabel}
		>
			<ul class="flex w-full items-center justify-between gap-4">
				{
					pages.map((link) => (
						<li>
							<a
								class="nav-link text-dark-800 dark:text-dark-200 hover:text-primary-700 dark:hover:text-primary-400 relative z-10 overflow-hidden p-2 transition-all duration-300"
								href={link.url}
								data-nav-target={link.id}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<LanguageSelector />
		<ThemeToggle />
		<HamburgerButton openLabel={navLabels.openMenuLabel} closeLabel={navLabels.closeMenuLabel} />
	</div>

	<style>
		.nav-link::before {
			content: "";
			position: absolute;
			bottom: 0;
			left: 0;
			height: 2px;
			width: 0;
			background-color: var(--color-primary-400);
			backdrop-filter: blur(8px);
			border-radius: 0.5rem;
			z-index: -10;
			transition: all 0.5s;
		}

		.nav-link:hover::before {
			width: 100%;
		}

		/* Header depth on scroll */
		header {
			transition:
				box-shadow 0.3s ease,
				border-color 0.3s ease;
			border-bottom: 1px solid transparent;
		}

		header.scrolled {
			box-shadow: 0 1px 0 0 rgb(0 0 0 / 0.08);
			border-bottom-color: rgb(0 0 0 / 0.07);
		}

		html.dark header.scrolled {
			box-shadow: 0 1px 0 0 rgb(255 255 255 / 0.06);
			border-bottom-color: rgb(255 255 255 / 0.06);
		}

		@keyframes fadeIn {
			from {
				opacity: 0;
			}

			to {
				opacity: 1;
			}
		}

		@keyframes fadeOut {
			from {
				opacity: 1;
			}

			to {
				opacity: 0;
			}
		}

		@keyframes growIn {
			from {
				transform: scale(0.96);
				opacity: 0;
			}

			to {
				transform: scale(1);
				opacity: 1;
			}
		}

		.menu-open {
			animation: fadeIn 0.2s ease forwards;
		}

		.menu-close {
			animation: fadeOut 0.2s ease forwards;
			opacity: 0;
		}

		.content-mobile {
			animation: growIn 0.3s ease forwards;
		}

		html.dark hr {
			background: linear-gradient(to right, transparent 0%, white 50%, transparent 100%);
		}

		hr {
			background: linear-gradient(to right, transparent 0%, black 50%, transparent 100%);
		}
	</style>

	<script>
		import "@/scripts/header.ts"
	</script>
</header>
