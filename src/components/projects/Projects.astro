---
import { getCollection } from "astro:content"
import ProjectItem from "@/components/projects/ProjectItem.astro"
import { getLocale } from "@/i18n"
import blurPlaceholders from "@/data/blur-placeholders.json"

const { currentLocale } = Astro
const locale = getLocale(currentLocale)

const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/projects/*", {
	eager: true,
})

const projectEntries = (await getCollection("projects"))
	.filter((entry) => entry.data.locale === locale)
	.sort((left, right) => left.data.order - right.data.order)

const projects = projectEntries.map(({ data: project }) => {
	const resolvedImage = images[`/src/assets/projects/${project.image}`]?.default
	const blurDataURL = project.image
		? (blurPlaceholders as Record<string, string>)[project.image]
		: undefined

	return {
		...project,
		image: resolvedImage,
		blurDataURL,
	}
})
---

<div class="flex flex-col gap-y-16">
	{
		projects.map((project, index) => (
			<div data-reveal data-reveal-delay={String(index * 120)}>
				<ProjectItem
					title={project.title}
					visibility={project.visibility}
					role={project.role}
					description={project.description}
					link={project.link}
					descriptionImage={project.descriptionImage}
					image={project.image}
					blurDataURL={project.blurDataURL}
					tags={project.tags}
				/>
			</div>
		))
	}
</div>
