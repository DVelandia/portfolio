---
import ProjectImagePanel from "@/components/projects/ProjectImagePanel.astro"
import ProjectInfoPanel from "@/components/projects/ProjectInfoPanel.astro"
import { getI18N } from "@/i18n"

interface Props {
	title: string
	visibility: "public" | "private"
	role?: string
	description: string
	link?: string
	descriptionImage: string
	image?: ImageMetadata
	blurDataURL?: string
	tags: { icon: string }[]
}

const { title, visibility, role, description, link, descriptionImage, image, blurDataURL, tags } =
	Astro.props

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
const isLinked = visibility === "public" && Boolean(link)
---

{
	isLinked ? (
		<a href={link} target="_blank" rel="noopener noreferrer" class="group block">
			<article class="flex flex-col space-y-8 space-x-0 rounded-xl transition duration-300 ease-in-out lg:flex-row lg:space-y-0 lg:space-x-8">
				<ProjectImagePanel
					title={title}
					descriptionImage={descriptionImage}
					image={image}
					blurDataURL={blurDataURL}
				/>
				<ProjectInfoPanel
					title={title}
					visibility={visibility}
					role={role}
					description={description}
					tags={tags}
					visibilityLabels={i18n.projects.visibility}
					newTab={i18n.projects.newTab}
					isLinked={isLinked}
				/>
			</article>
		</a>
	) : (
		<div class="group">
			<article class="flex flex-col space-y-8 space-x-0 rounded-xl transition duration-300 ease-in-out lg:flex-row lg:space-y-0 lg:space-x-8">
				<ProjectImagePanel
					title={title}
					descriptionImage={descriptionImage}
					image={image}
					blurDataURL={blurDataURL}
				/>
				<ProjectInfoPanel
					title={title}
					visibility={visibility}
					role={role}
					description={description}
					tags={tags}
					visibilityLabels={i18n.projects.visibility}
					newTab={i18n.projects.newTab}
					isLinked={isLinked}
				/>
			</article>
		</div>
	)
}
