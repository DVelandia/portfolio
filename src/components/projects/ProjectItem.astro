---
import { Image } from "astro:assets"
import Icon from "@/components/ui/Icon.astro"
import Link from "@/icons/Link.astro"
import { getI18N } from "@/i18n"

interface Props {
	title: string
	visibility: "public" | "private"
	role?: string
	description: string
	link?: string
	descriptionImage: string
	image?: ImageMetadata
	blurDataURL?: string
	tags: { icon: string }[]
}

interface TagClasses {
	[key: string]: string
}

const tagClasses: TagClasses = {
	Azure: "bg-[#003A78]",
	Angular: "bg-[#6D143F]",
	Drupal: "bg-[#003A61]",
	WordPress: "bg-[#123B4D]",
	PHP: "bg-[#29325C]",
	Sass: "bg-[#6F2B53]",
	Bootstrap: "bg-[#2F1F59]",
	Tailwind: "bg-[#0B3B55]",
	Express: "bg-[#374151]",
	Figma: "bg-[#5B2499]",
	GCP: "bg-[#174EA6]",
	JQuery: "bg-[#08365C]",
	JavaScript: "bg-[#4B4300]",
}

const roleBadgeClasses: TagClasses = {
	FullStack:
		"border-emerald-500/40 bg-emerald-500/10 text-emerald-700 dark:border-emerald-400/40 dark:bg-emerald-400/10 dark:text-emerald-300",
	FrontEnd:
		"border-sky-500/40 bg-sky-500/10 text-sky-700 dark:border-sky-400/40 dark:bg-sky-400/10 dark:text-sky-300",
	BackEnd:
		"border-violet-500/40 bg-violet-500/10 text-violet-700 dark:border-violet-400/40 dark:bg-violet-400/10 dark:text-violet-300",
}

const { title, visibility, role, description, link, descriptionImage, image, blurDataURL, tags } =
	Astro.props

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
const vis = i18n.projects.visibility
const newTab = i18n.projects.newTab

const isPublicProject = visibility === "public" && Boolean(link)
const isPrivate = visibility === "private"
---

{
	isPublicProject ? (
		<a href={link} target="_blank" rel="noopener noreferrer" class="group block">
			<article class="flex flex-col space-y-8 space-x-0 rounded-xl lg:flex-row lg:space-y-0 lg:space-x-8">
				{/* Image panel */}
				<div class="w-full lg:w-1/2">
					<div
						class="relative col-span-6 row-span-5 flex transform flex-col items-center gap-8 overflow-clip rounded-xl shadow-xl transition duration-500 ease-in-out sm:rounded-xl lg:group-hover:-translate-y-1 lg:group-hover:shadow-2xl"
						style={
							blurDataURL
								? `background-image: url('${blurDataURL}'); background-size: cover; background-position: center top;`
								: undefined
						}
					>
						{image ? (
							<Image
								src={image}
								alt={descriptionImage}
								title={descriptionImage}
								widths={[480, 640, 800]}
								sizes="(min-width: 1024px) 50vw, 100vw"
								width={800}
								height={450}
								quality={80}
								class="h-56 w-full object-cover object-top transition duration-500 sm:h-full lg:scale-110 lg:group-hover:scale-105"
								loading="lazy"
								decoding="async"
							/>
						) : (
							<div class="from-primary-950 via-primary-900 to-dark-950 flex h-56 w-full items-end bg-gradient-to-br p-6 sm:h-full">
								<strong class="text-3xl font-semibold text-white">{title}</strong>
							</div>
						)}
					</div>
				</div>

				{/* Info panel */}
				<div class="flex w-full flex-col justify-center lg:w-1/2 lg:max-w-lg">
					{/* Title + badges inline */}
					<div class="mb-1 flex flex-wrap items-center gap-2">
						<h3 class="group-hover:text-primary-700 dark:group-hover:text-primary-400 text-dark-900 dark:text-primary-50 flex items-center gap-2 text-lg font-bold transition-colors duration-300">
							<span>{title}</span>
							<Link
								class="inline-block h-4 w-4 shrink-0 translate-y-px transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:scale-125 motion-reduce:transition-none"
								aria-hidden="true"
							/>
							<span class="sr-only">{newTab}</span>
						</h3>
						{/* Visibility badge — public */}
						<span class="inline-flex items-center gap-1 rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2 py-0.5 text-[10px] font-medium tracking-[0.18em] text-emerald-700 uppercase dark:border-emerald-400/40 dark:bg-emerald-400/10 dark:text-emerald-300">
							{vis.public}
						</span>
						{/* Role badge */}
						{role ? (
							<span
								class:list={[
									"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium tracking-[0.18em] uppercase",
									roleBadgeClasses[role] ||
										"border-slate-700/60 text-slate-500 dark:text-slate-300",
								]}
							>
								{role}
							</span>
						) : null}
					</div>

					{/* Tags */}
					<ul class="mt-4 mb-2 flex flex-row flex-wrap gap-2">
						{tags.map((tag) => (
							<li>
								<span
									class:list={[
										"flex items-center gap-x-2 rounded-full px-2 py-1 text-xs text-white dark:ring-1 dark:ring-white/25",
										tagClasses[tag.icon] || "bg-gray-600",
									]}
								>
									<Icon name={tag.icon} class="h-4 w-4 brightness-0 invert" aria-hidden="true" />
									{tag.icon}
								</span>
							</li>
						))}
					</ul>

					{/* Description */}
					<p class="text-dark-700 dark:text-dark-300 mt-3 text-sm leading-6">{description}</p>
				</div>
			</article>
		</a>
	) : (
		<article class="group flex flex-col space-y-8 space-x-0 rounded-xl transition duration-300 ease-in-out lg:flex-row lg:space-y-0 lg:space-x-8">
			{/* Image panel */}
			<div class="w-full lg:w-1/2">
				<div
					class="relative col-span-6 row-span-5 flex transform overflow-clip rounded-xl shadow-xl transition duration-500 ease-in-out sm:rounded-xl lg:group-hover:-translate-y-1 lg:group-hover:shadow-2xl"
					style={
						blurDataURL
							? `background-image: url('${blurDataURL}'); background-size: cover; background-position: center top;`
							: undefined
					}
				>
					{image ? (
						<Image
							src={image}
							alt={descriptionImage}
							title={descriptionImage}
							widths={[480, 640, 800]}
							sizes="(min-width: 1024px) 50vw, 100vw"
							width={800}
							height={450}
							quality={80}
							class="h-56 w-full object-cover object-top transition duration-500 sm:h-full lg:scale-110 lg:group-hover:scale-105"
							loading="lazy"
							decoding="async"
						/>
					) : (
						<div class="from-primary-950 via-primary-900 to-dark-950 flex h-56 w-full items-end bg-gradient-to-br p-6 sm:h-full">
							<strong class="text-3xl font-semibold text-white">{title}</strong>
						</div>
					)}
				</div>
			</div>

			{/* Info panel */}
			<div class="flex w-full flex-col justify-center lg:w-1/2 lg:max-w-lg">
				{/* Title + badges inline */}
				<div class="mb-1 flex flex-wrap items-center gap-2">
					<h3 class="text-dark-900 dark:text-primary-50 text-lg font-bold">{title}</h3>
					{/* Visibility badge — private */}
					{isPrivate ? (
						<span
							title={vis.privateLabel}
							class="inline-flex items-center gap-1 rounded-full border border-slate-500/40 bg-slate-500/10 px-2 py-0.5 text-[10px] font-medium tracking-[0.18em] text-slate-600 uppercase dark:border-slate-400/40 dark:bg-slate-400/10 dark:text-slate-400"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="h-3 w-3"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
							>
								<path
									fill-rule="evenodd"
									d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25v3a3 3 0 0 0-3 3v6.75a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3v-6.75a3 3 0 0 0-3-3v-3c0-2.9-2.35-5.25-5.25-5.25Zm3.75 8.25v-3a3.75 3.75 0 1 0-7.5 0v3h7.5Z"
									clip-rule="evenodd"
								/>
							</svg>
							{vis.private}
						</span>
					) : null}
					{/* Role badge */}
					{role ? (
						<span
							class:list={[
								"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium tracking-[0.18em] uppercase",
								roleBadgeClasses[role] || "border-slate-700/60 text-slate-500 dark:text-slate-300",
							]}
						>
							{role}
						</span>
					) : null}
				</div>

				{/* Tags */}
				<ul class="mt-4 mb-2 flex flex-row flex-wrap gap-2">
					{tags.map((tag) => (
						<li>
							<span
								class:list={[
									"flex items-center gap-x-2 rounded-full px-2 py-1 text-xs text-white dark:ring-1 dark:ring-white/25",
									tagClasses[tag.icon] || "bg-gray-600",
								]}
							>
								<Icon name={tag.icon} class="h-4 w-4 brightness-0 invert" aria-hidden="true" />
								{tag.icon}
							</span>
						</li>
					))}
				</ul>

				{/* Description */}
				<p class="text-dark-700 dark:text-dark-300 mt-3 text-sm leading-6">{description}</p>
			</div>
		</article>
	)
}
