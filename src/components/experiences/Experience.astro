---
import { getCollection } from "astro:content"
import ExperienceItem from "@/components/experiences/ExperienceItem.astro"

const { currentLocale } = Astro
const locale = currentLocale === "en" ? "en" : "es"
const experiences = (await getCollection("experience"))
	.filter((entry) => entry.data.locale === locale)
	.sort((left, right) => left.data.order - right.data.order)
---

<article class="container mt-10 px-3.5">
	<ol class="border-dark-400 dark:border-dark-700 relative border-l">
		{
			experiences.map(({ data: experience }) => (
				<li class="mb-8 ml-6 md:mb-6">
					<ExperienceItem
						icon={experience.icon}
						title={experience.title}
						link={experience.link || ""}
						company={experience.company}
						date={experience.date}
						description={experience.description}
					/>
				</li>
			))
		}
	</ol>
</article>
