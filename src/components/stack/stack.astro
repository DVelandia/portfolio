---
import { getCollection } from "astro:content"
import SectionItem from "@/components/stack/SectionItem.astro"
import { getI18N } from "@/i18n/"

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
const stackSections = (await getCollection("stack")).sort(
	(left, right) => left.data.order - right.data.order
)

const { journey, webDevWorld, cultivated, skillsGained, techVariety, stackIntro } =
	i18n.technologies.intro
---

<p class="dark:text-dark-300 my-8 max-w-[740px] text-pretty text-gray-600 md:text-lg">
	{journey}
	<span class="text-daintree-800 dark:text-daintree-300">
		{webDevWorld}
	</span>
	{cultivated}
	<span class="text-crusta-700 dark:text-crusta-300">
		{skillsGained}
	</span>
	{techVariety}
	<span class="text-daintree-800 dark:text-daintree-300 font-semibold">
		{stackIntro}
	</span>
</p>

<section class="grid gap-12 lg:grid-cols-2 lg:place-content-center">
	{
		stackSections.map(({ id, data: section }) => (
			<SectionItem
				key={id}
				gradient={section.gradient}
				title={i18n.technologies.categories[id as keyof typeof i18n.technologies.categories]}
				icons={section.icons}
			/>
		))
	}
</section>
