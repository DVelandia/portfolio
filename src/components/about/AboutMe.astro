---
import { Image } from "astro:assets"
import imageProfile from "@/assets/me.webp"
import { getResumePath, publicProfile } from "@/data/publicProfile"
import { getI18N } from "@/i18n/"
import ArrowDown from "@/icons/ArrowDown.astro"
import Download from "@/icons/Download.astro"
import Email from "@/icons/Email.astro"
import GitHub from "@/icons/GitHubOutlined.astro"
import LinkedIn from "@/icons/LinkedIn.astro"

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })

const { descriptionImage, role, experience, greeting, seeMore } = i18n.about
const { hello, name } = greeting
const { years, title, specialization } = experience
const resumePath = getResumePath(currentLocale)
const experienceHref = `#${i18n.experience.id}`

const socialLinks = [
	{
		href: publicProfile.social.linkedin,
		icon: LinkedIn,
		label: "LinkedIn",
		rel: "noopener noreferrer",
		target: "_blank",
		variant: "primary",
	},
	{
		href: publicProfile.social.github,
		icon: GitHub,
		label: "GitHub",
		rel: "noopener noreferrer",
		target: "_blank",
		variant: "secondary",
	},
	{
		href: `mailto:${publicProfile.contact.email}`,
		icon: Email,
		label: publicProfile.contact.email,
		target: "_self",
		variant: "secondary",
	},
	{
		href: resumePath,
		icon: Download,
		label: "Curriculum",
		target: "_self",
		variant: "secondary",
	},
]
---

<div
	class="hero-enter flex w-full flex-col items-center gap-y-6 text-center md:gap-x-4 lg:flex-row-reverse lg:items-center lg:justify-center lg:gap-y-0 lg:text-left"
>
	<div class="hero-enter__item Hero-image flex w-28 justify-center sm:w-32 lg:mb-0 lg:w-1/5">
		<Image
			src={imageProfile}
			alt={descriptionImage}
			title={descriptionImage}
			widths={[96, 112, 148, 192, 224, 296]}
			sizes="(min-width: 1024px) 148px, (min-width: 640px) 112px, 96px"
			width={296}
			height={296}
			quality={80}
			loading="eager"
			fetchpriority="high"
			decoding="async"
			class="hover:shadow-primary-700/20 dark:shadow-dark-800 w-full rounded-full object-contain shadow-lg transition-shadow duration-300 hover:shadow-xl hover:dark:shadow-white/2"
		/>
	</div>

	<header class="hero-enter__item lg:w-4/5">
		<h1 class="text-dark-900 text-3xl font-bold sm:text-4xl lg:text-5xl dark:text-white">
			{hello}
			<span class="text-primary-600 dark:text-primary-400">
				{name}
			</span>
		</h1>
		<span
			class="animated-text inline-flex bg-[linear-gradient(110deg,#5f7286,45%,#0f2233,55%,#5f7286)] bg-[length:250%_100%] bg-clip-text text-xl font-semibold text-transparent lg:text-2xl dark:bg-[linear-gradient(110deg,#d8f1f6,45%,#4aa3d1,55%,#d8f1f6)]"
		>
			{role}
		</span>
		<h2
			class="text-dark-700 dark:text-dark-300 mt-6 text-lg text-pretty md:mt-10 md:text-xl lg:text-2xl"
		>
			{years}
			<span class="text-crusta-800 dark:text-crusta-300">
				{title}
			</span>
			<span class="text-daintree-700 dark:text-daintree-200">
				{specialization}
			</span>
		</h2>
	</header>
</div>
<ul class="hero-enter__item mt-8 flex flex-wrap justify-center gap-4 lg:justify-start">
	{
		socialLinks.map(({ href, icon: Icon, label, rel, target, variant }) => (
			<li>
				{variant === "primary" ? (
					<a
						href={href}
						class="linkedin-cta inline-flex overflow-hidden rounded-full p-px text-xs transition-transform hover:scale-105 md:text-base"
						target={target}
						rel={rel}
						download={href.endsWith(".pdf") ? "" : null}
					>
						<span class="linkedin-cta__content text-dark-700 dark:text-dark-200 flex items-center justify-center gap-x-2 rounded-full bg-gradient-to-r from-slate-50 to-slate-100 px-2 py-1 md:px-4 md:py-2 dark:from-slate-800 dark:to-slate-950">
							<Icon class="size-4 md:size-6" />
							{label}
						</span>
					</a>
				) : (
					<a
						href={href}
						class="border-dark-300 dark:border-dark-700 text-dark-700 dark:text-dark-200 flex items-center justify-center gap-x-2 rounded-full border bg-gradient-to-r from-slate-50 to-slate-100 px-2 py-1 text-xs transition-transform hover:scale-105 md:px-4 md:py-2 md:text-base dark:from-slate-800 dark:to-slate-950"
						target={target}
						rel={rel}
						download={href.endsWith(".pdf") ? "" : null}
					>
						<Icon class="size-4 md:size-6" />
						{label}
					</a>
				)}
			</li>
		))
	}
</ul>
<div class="hero-enter__item absolute bottom-4 flex w-full justify-center">
	<a
		href={experienceHref}
		class="text-primary-500 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 flex gap-2 font-bold transition-colors"
	>
		{seeMore}
		<ArrowDown class="h-5 w-5" />
	</a>
</div>

<style>
	@keyframes background-shine {
		from {
			background-position: 0 0;
		}
		to {
			background-position: -200% 0;
		}
	}

	.animated-text {
		animation: background-shine 2s linear infinite;
	}

	@keyframes hero-enter {
		from {
			opacity: 0;
			transform: translateY(0.75rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-enter__item {
		animation: hero-enter 0.55s ease both;
	}

	.hero-enter__item:nth-child(2) {
		animation-delay: 0.08s;
	}

	.hero-enter + .hero-enter__item,
	.hero-enter__item.absolute {
		animation-delay: 0.16s;
	}

	@keyframes linkedin-border-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	.linkedin-cta {
		isolation: isolate;
		position: relative;
	}

	.linkedin-cta::before {
		content: "";
		position: absolute;
		inset: -160%;
		background: conic-gradient(
			from 90deg at 50% 50%,
			rgba(74, 163, 209, 0) 0deg,
			rgba(74, 163, 209, 0) 318deg,
			rgba(74, 163, 209, 0.95) 332deg,
			rgba(74, 163, 209, 0.35) 344deg,
			rgba(74, 163, 209, 0) 360deg
		);
		animation: linkedin-border-spin 2.6s linear infinite;
		pointer-events: none;
	}

	.linkedin-cta__content {
		position: relative;
		z-index: 1;
		box-shadow: inset 0 0 0 1px rgb(74 163 209 / 0.12);
	}

	@media (prefers-reduced-motion: reduce) {
		.animated-text,
		.hero-enter__item,
		.linkedin-cta::before {
			animation: none;
		}
	}
</style>
