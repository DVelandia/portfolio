---
import { getI18N } from "@/i18n"
import MoonIcon from "@/icons/Moon.astro"
import SunIcon from "@/icons/Sun.astro"
import SystemIcon from "@/icons/System.astro"

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })

const THEMES = ["light", "dark", "system"] as const
const spanTheme = i18n.theme.spanTheme
---

<div class="relative">
	<button
		id="theme-toggle-btn"
		type="button"
		aria-controls="themes-menu"
		aria-expanded="false"
		aria-haspopup="true"
		class="flex rounded border-2 border-black/10 p-2 transition hover:border-black/20 hover:bg-black/5 dark:border-white/10 dark:hover:border-white/30 dark:hover:bg-white/5"
	>
		<span class="sr-only">{spanTheme}</span>
		<SunIcon id="light" class="theme-toggle-icon size-5 scale-0 opacity-0 transition-all" />
		<MoonIcon
			id="dark"
			class="theme-toggle-icon absolute size-5 scale-0 opacity-0 transition-all"
		/>
		<SystemIcon
			id="system"
			class="theme-toggle-icon absolute size-5 scale-0 opacity-0 transition-all"
		/>
	</button>
	<div
		id="themes-menu"
		class="text-dark-700 dark:text-dark-100 absolute top-10 right-0 min-w-[8rem] rounded-md border border-gray-100 bg-white/90 p-1 text-sm shadow-[0_3px_10px_rgb(0,0,0,0.2)] backdrop-blur-md dark:border-gray-500/20 dark:bg-gray-900/90"
		hidden
	>
		<fieldset class="flex flex-col gap-1">
			<legend class="sr-only">{spanTheme}</legend>
			{
				THEMES.map((theme) => (
					<label class="block cursor-pointer">
						<input
							type="radio"
							name="theme-option"
							value={theme}
							class="theme-toggle-option peer sr-only"
						/>
						<span class="peer-focus-visible:outline-primary-600 flex rounded-sm px-2 py-1.5 text-left transition peer-checked:bg-neutral-400/40 peer-checked:font-medium peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 hover:bg-neutral-400/40 dark:peer-checked:bg-gray-500/50 dark:hover:bg-gray-500/50">
							{i18n.theme[theme as keyof typeof i18n.theme]}
						</span>
					</label>
				))
			}
		</fieldset>
	</div>
</div>

<script>
	import "@/scripts/theme-toggle.ts"
</script>
