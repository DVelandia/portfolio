---
import { publicProfile } from "@/data/publicProfile"
import { getI18N } from "@/i18n"

const currentYear = new Date().getFullYear()
const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })

const pages = ["about", "experience", "projects", "technologies"].map((key) => ({
	title: (i18n[key as keyof typeof i18n] as { id: string }).id,
	url: `${currentLocale === "en" ? "/en/" : "/"}#${(i18n[key as keyof typeof i18n] as { id: string }).id}`,
}))
const profileUrl = currentLocale === "en" ? "/en/about-daniel-velandia/" : "/sobre-daniel-velandia/"
---

<footer class="container mx-auto mt-14 mb-8 w-full px-4 sm:w-[600px] md:px-0 lg:w-[740px]">
	<div
		class="border-dark-100 dark:border-dark-700 dark:shadow-dark-700 mx-auto flex max-w-screen-xl flex-col items-center gap-y-1 rounded-lg p-4 shadow lg:flex-row lg:justify-between"
	>
		<span class="text-dark-700 dark:text-dark-200 flex text-center text-xs"
			>©️ {currentYear} {publicProfile.fullName}. {i18n.rightsReserved}
		</span>
		<nav
			class="text-dark-700 dark:text-dark-200 mt-3 flex flex-wrap items-center text-xs font-medium sm:mt-0"
			aria-label={i18n.nav.footerLabel}
		>
			{
				pages.map(({ title, url }) => (
					<a
						class="hover:text-primary-700 dark:hover:text-primary-400 ml-3 transition-colors hover:underline"
						href={url}
					>
						{i18n.menu[title as keyof typeof i18n.menu]}
					</a>
				))
			}
			<a
				class="hover:text-primary-700 dark:hover:text-primary-400 ml-3 transition-colors hover:underline"
				href={profileUrl}
			>
				{i18n.menu.profile}
			</a>
		</nav>
	</div>
</footer>
